// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstname String   @db.VarChar(110)
  lastname  String   @db.VarChar(110)
  phone     String?  @db.VarChar(20)
  password  String   @db.VarChar(255)
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avatarId Int?   @unique
  avatar   Media? @relation(fields: [avatarId], references: [id], onDelete: SetNull)

  memberships  UserBand[]
  authSessions AuthSession[]
  bandContacts BandContact[]
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

enum Role {
  ADMIN
  USER
}

model Band {
  id        String   @id @default(uuid())
  label     String   @unique @db.VarChar(110)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     UserBand[]
  musicStyle      MusicStyle?      @relation(fields: [musicStyleId], references: [id])
  musicStyleId    Int?
  technicalRiders TechnicalRider[]
  bandContacts    BandContact[]
}

model Media {
  id     Int    @id @default(autoincrement())
  bucket String
  folder String
  path   String
  user   User?
}

model UserBand {
  id Int @id @default(autoincrement())

  userId String?
  bandId String

  firstname String?
  lastname  String?

  role BandRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
  band Band  @relation(fields: [bandId], references: [id], onDelete: Cascade)

  userBandInstruments UserBandInstrument[]
  bandContact         BandContact?

  @@unique([userId, bandId])
}

model UserBandInstrument {
  userBandId   Int
  instrumentId Int

  userBand   UserBand   @relation(fields: [userBandId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@id([userBandId, instrumentId])
}

enum BandRole {
  LEADER
  MEMBER
}

model MusicStyle {
  id        Int      @id @default(autoincrement())
  label     String   @unique @db.VarChar(45)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands Band[]
}

model TechnicalRider {
  id String @id @default(uuid())

  title  String      @db.VarChar(150)
  status RiderStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalRiderGeneral  TechnicalRiderGeneral?
  technicalRiderStage    TechnicalRiderStage?
  technicalRiderAudio    TechnicalRiderAudio?
  technicalRiderLogistic TechnicalRiderLogistic?

  band                Band                  @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId              String
  riderCategory       RiderCategory         @relation(fields: [riderCategoryId], references: [id])
  riderCategoryId     Int
  stageInstruments    StageInstrument[]
  TechnicalRiderStaff TechnicalRiderStaff[]
  bandContact         BandContact?          @relation(fields: [bandContactId], references: [id])
  bandContactId       Int?
}

model TechnicalRiderGeneral {
  id Int @id @default(autoincrement())

  musicianNumber     Int?
  setDuration        Int?
  soundcheckDuration Int?
  changeoverDuration Int?
  setupDuration      Int?
  teardownDuration   Int?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  technicalRiderId String         @unique
  technicalRider   TechnicalRider @relation(fields: [technicalRiderId], references: [id], onDelete: Cascade)
}

model TechnicalRiderStaff {
  id Int @id @default(autoincrement())

  firstname String?
  lastname  String?
  email     String?
  phone     String?

  role TechnicalStaffRole

  technicalRiderId String
  technicalRider   TechnicalRider @relation(fields: [technicalRiderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TechnicalStaffRole {
  SOUND_ENGINEER
  LIGHT_ENGINEER
}

model TechnicalRiderStage {
  id Int @id @default(autoincrement())

  stageLength      Int?
  stageWidth       Int?
  stageDepth       Int?
  stageAccess      String?
  backlineProvided String?

  technicalRiderId String         @unique
  technicalRider   TechnicalRider @relation(fields: [technicalRiderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TechnicalRiderAudio {
  id Int @id @default(autoincrement())

  consoleChannelCount      Int?
  soundLevelRequirements   String?
  specialAudioRequirements String?
  inputPatch               Json?
  stageMonitoringSetup     Json?
  micsDisSetup             Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalRiderId String         @unique
  technicalRider   TechnicalRider @relation(fields: [technicalRiderId], references: [id], onDelete: Cascade)
}

model TechnicalRiderLogistic {
  id Int @id @default(autoincrement())

  specificRisks     String?
  loadInTime        String?
  loadOutTime       String?
  cateringInfo      String?
  accommodationInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalRiderId String         @unique
  technicalRider   TechnicalRider @relation(fields: [technicalRiderId], references: [id], onDelete: Cascade)
}

model RiderCategory {
  id        Int      @id @default(autoincrement())
  label     String   @unique @db.VarChar(45)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalRiders TechnicalRider[]
}

enum RiderStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BandContact {
  id          Int         @id @default(autoincrement())
  firstname   String?
  lastname    String?
  email       String?
  phone       String?
  contactRole ContactRole @default(UNKNOWN)
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bandId          String
  band            Band             @relation(fields: [bandId], references: [id], onDelete: Cascade)
  userBandId      Int?             @unique
  userBand        UserBand?        @relation(fields: [userBandId], references: [id], onDelete: Cascade)
  technicalRiders TechnicalRider[]
  user            User?            @relation(fields: [userId], references: [id])
  userId          String?
}

enum ContactRole {
  MEMBER
  MANAGER
  BOOKING
  TOUR_MANAGER
  LABEL
  OTHER
  UNKNOWN
}

model InstrumentCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(110)
  label     String   @db.VarChar(110)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Instruments Instrument[]
}

model Instrument {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(110)
  label     String   @db.VarChar(110)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instrumentCategory   InstrumentCategory   @relation(fields: [instrumentCategoryId], references: [id])
  instrumentCategoryId Int
  stageInstruments     StageInstrument[]
  userBandInstruments  UserBandInstrument[]
}

model StageInstrument {
  id        Int      @id @default(autoincrement())
  posX      Int
  posY      Int
  scale     Int
  rotation  Int
  zIndex    Int?
  label     String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicalRider   TechnicalRider @relation(fields: [technicalRiderId], references: [id])
  technicalRiderId String
  instrument       Instrument?    @relation(fields: [instrumentId], references: [id])
  instrumentId     Int?
}
